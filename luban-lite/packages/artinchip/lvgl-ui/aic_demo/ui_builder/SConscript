from building import *
import os

cwd = GetCurrentDir()
group = []
CPPPATH = [cwd]
CPPPATH += [cwd + '/custom']
CPPPATH += [cwd + '/font']
CPPPATH += [cwd + '/view']
CPPPATH += [cwd + '/view/home_view']
CPPPATH += [cwd + '/view/setting_view']
CPPPATH += [cwd + '/view/phone_view']
CPPPATH += [cwd + '/proxy']
CPPPATH += [cwd + '/logic']

src  = Glob('*.c')
src += Glob('custom/*.c')
src += Glob('font/*.c')
src += Glob('view/*.c')
src += Glob('view/home_view/*.c')
src += Glob('view/setting_view/*.c')
src += Glob('view/phone_view/*.c')
src += Glob('proxy/*.c')
src += Glob('logic/*.c')

list = os.listdir(cwd)
for d in list:
    path = os.path.join(cwd, d)
    if os.path.isfile(os.path.join(path, 'SConscript')):
        group = group + SConscript(os.path.join(d, 'SConscript'))

if GetDepend(['LVGL_STORAGE_PATH']):
    ins_dst = GetDepend('LVGL_STORAGE_PATH').strip('"/')
else:
    ins_dst='rodata/lvgl_data'

ins_src = 'assets/'
install = [(ins_src, ins_dst)]

group = group + DefineGroup('LVGL-port', src, depend = ['HCN_D123BBV_DEMO'], CPPPATH = CPPPATH,
        INSTALL = install)

Return('group')