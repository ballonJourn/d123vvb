# blenavi. Upstream libraries are imported unmodified (git subtree, see
# D133-CHANGES.md) and compiled from their own directories; rtthread/ holds
# the D133 code and rtthread/compat/ the platform glue they need.
from building import *

cwd = GetCurrentDir()

cxx = Glob('esp-nimble-cpp/src/*.cpp') + [
    cwd + '/chronos-esp32/src/ChronosESP32.cpp',
    cwd + '/ESP32Time/ESP32Time.cpp',
    cwd + '/ArduinoCore-API/api/String.cpp',
    cwd + '/ArduinoCore-API/api/Print.cpp',
    cwd + '/ArduinoCore-API/api/Common.cpp',
    cwd + '/rtthread/compat/arduino_rtt.cpp',
    cwd + '/rtthread/bnp_service.cpp',
    cwd + '/rtthread/blenavi_main.cpp',
]
c = [
    cwd + '/rtthread/ble_img_rx.c',
    cwd + '/rtthread/disp_sink.c',
    cwd + '/rtthread/compat/arduino_libc_rtt.c',
    cwd + '/rtthread/compat/nimble_port_freertos_rtt.c',
]

path = [
    cwd + '/rtthread/compat',            # Arduino.h, esp_log.h, Stream.h, WString.h
    cwd + '/rtthread',
    cwd + '/esp-nimble-cpp/src',
    cwd + '/chronos-esp32/src',
    cwd + '/ESP32Time',
    cwd + '/ArduinoCore-API',
    cwd + '/ArduinoCore-API/api/deprecated-avr-comp',
    cwd + '/..',                         # "nimble/nimble/controller/..." (vendor tree layout)
]

# esp-nimble-cpp: platform shim force-included; -fpermissive because the vendor
# NimBLE port headers pull aic_osal.h (C-only implicit void* conversions).
cxxflags = ' -fpermissive -include ' + cwd + '/rtthread/compat/esp_nimble_cpp_rtt.h'

group  = DefineGroup('blenavi', cxx, depend = ['LPKG_USING_BLENAVI'],
                     LOCAL_CPPPATH = path, LOCAL_CXXFLAGS = cxxflags)
group += DefineGroup('blenavi', c, depend = ['LPKG_USING_BLENAVI'],
                     LOCAL_CPPPATH = path)

Return('group')
