CONFIG_AIC_WIRELESS_LAN=y
CONFIG_AIC_WLAN_AIC8800D40L=y
CONFIG_CONFIG_AIC8800_BT_SUPPORT=y
CONFIG_AIC_USING_UART2=y
CONFIG_AIC_DEV_UART2_BAUDRATE=1500000
CONFIG_AIC_DEV_UART2_MODE_RS232_AUTO_FLOW_CTRL=y
CONFIG_LPKG_USING_NIMBLE=y
CONFIG_LPKG_NIMBLE_HCI_USING_RTT_UART=y
CONFIG_LPKG_NIMBLE_HCI_UART_DEVICE_NAME="uart2"
CONFIG_LPKG_NIMBLE_HCI_H4=y
CONFIG_LPKG_NIMBLE_HOST_THREAD_STACK_SIZE=4096
CONFIG_LPKG_NIMBLE_SAMPLE_DISABLE=y
CONFIG_LPKG_USING_BLENAVI=y
