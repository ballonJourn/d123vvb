# blenavi: BLE navigation receiver for D133 (chronos-esp32 + BNP image service)
menuconfig LPKG_USING_BLENAVI
    bool "blenavi: BLE navigation receiver (Chronos app + BNP image frames)"
    depends on CONFIG_AIC8800_BT_SUPPORT
    select LPKG_USING_NIMBLE
    select LPKG_NIMBLE_ROLE_PERIPHERAL
    select LPKG_NIMBLE_HOST
    select LPKG_NIMBLE_HCI_USING_RTT_UART
    select LPKG_NIMBLE_HCI_H4
    select LPKG_USING_FREERTOS_WRAPPER
    select RT_USING_CPLUSPLUS
    select AIC_GE_DRV
    default n
    help
      Runs fbiego/chronos-esp32 (unmodified) on h2zero/esp-nimble-cpp 2.6.0
      (unmodified) over the vendor NimBLE (packages/third-party/nimble) and
      the AIC8800 BT core (aicbt_init, CONFIG_AIC8800_BT_SUPPORT), plus a BNP
      image service on the same server. Frames go to VE/GE via disp_sink.
      Needs UART2 = RS232_AUTO_FLOW_CTRL at 1500000 and
      LPKG_NIMBLE_SAMPLE_DISABLE (esp-nimble-cpp starts the host thread).
      See D133-CHANGES.md.

if LPKG_USING_BLENAVI
    config BLENAVI_DEV_NAME
        string "Advertised device name"
        default "D133-Navi"

    config BLENAVI_MAX_FRAME_BYTES
        int "Largest BNP frame (bytes, CMA)"
        default 1228800
        help
          demo88 panel 1024x600 RGB565 = 1228800. JPEG frames are far smaller.

    config BLENAVI_CONN_INTERVAL_MS
        int "Requested connection interval (ms)"
        range 8 100
        default 15

    config BLENAVI_TURN_X
        int "Turn icon X"
        default 16
    config BLENAVI_TURN_Y
        int "Turn icon Y"
        default 16
    config BLENAVI_TURN_SCALE
        int "Turn icon scale (48 px * N)"
        range 1 4
        default 2

    config BLENAVI_AUTOSTART
        bool "Start at boot"
        default n
endif
