Import('RTT_ROOT')
Import('rtconfig')
from building import *

cwd = GetCurrentDir()
src = Split('''
ble_img_rx.c
chronos_nav.c
ble_service.c
disp_sink.c
''')
path = [cwd]
if GetDepend(['BLE_NAVI_ERYA']):
    src += ['erya_proto.c', 'erya_json.c']
    # cJSON: SDK package if enabled, else the copy the application builds
    if not GetDepend(['LPKG_USING_CJSON']):
        import os
        app_json = os.path.join(cwd, '..', '..', '..', 'application', 'rt-thread',
                                'helloworld', 'third', 'json')
        if os.path.exists(os.path.join(app_json, 'cJSON.h')):
            path += [os.path.normpath(app_json)]
if GetDepend(['BLE_NAVI_BACKEND_NIMBLE']):
    src += ['ble_port_nimble.c']

defs = []
if GetDepend(['BLE_NAVI_BACKEND_NIMBLE']):
    # syscfg.h guards the macro with #ifndef: the vendor file stays untouched.
    # An old .config without the symbol has no BuildOptions entry.
    try:
        blocks = int(GetConfigValue('BLE_NAVI_MSYS_BLOCKS'))
    except (KeyError, ValueError):
        blocks = 0
    if blocks:
        defs += ['MYNEWT_VAL_MSYS_1_BLOCK_COUNT=%d' % blocks]

group = DefineGroup('ble_navi', src, depend=['LPKG_USING_BLE_NAVI'], CPPPATH=path, CPPDEFINES=defs)
Return('group')
