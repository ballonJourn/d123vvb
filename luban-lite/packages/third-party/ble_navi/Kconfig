menuconfig LPKG_USING_BLE_NAVI
    bool "BLE Navi: BLE GATT image/navigation receiver (BNP + Chronos compat)"
    default n
    depends on !LPKG_USING_BLENAVI
    select AIC_GE_DRV
    help
      D133 as BLE peripheral: receives navigation frames (JPEG/RGB565/1bpp icon)
      and route text from a phone/PC, shows them via VE+GE.
      Protocol: firmware/ble_navi/bnp_proto.h

if LPKG_USING_BLE_NAVI

choice
    prompt "BLE host backend"
    default BLE_NAVI_BACKEND_NIMBLE

config BLE_NAVI_BACKEND_NIMBLE
    bool "NimBLE host (vendor local package packages/third-party/nimble) over HCI UART"
    depends on CONFIG_AIC8800_BT_SUPPORT
    select LPKG_USING_NIMBLE
    select LPKG_NIMBLE_ROLE_PERIPHERAL
    select LPKG_NIMBLE_HOST
    select LPKG_NIMBLE_HCI_USING_RTT_UART
    help
      Uses the ArtInChip NimBLE local package (H4, 1.5 Mbps, HW auto flow
      control in its rtthread transport) and the AIC8800 driver's aicbt_init
      (enabled by CONFIG_AIC8800_BT_SUPPORT) which loads the BT patch over SDIO
      and puts BT on UART. Set UART2 to RS232_AUTO_FLOW_CTRL, 1500000 baud.
      Keep LPKG_NIMBLE_CTLR off. LPKG_NIMBLE_HCI_H4 and
      LPKG_NIMBLE_SAMPLE_DISABLE are choice members: Kconfig cannot select
      them, so they are set in the board defconfig.

endchoice

config BLE_NAVI_DEV_NAME
    string "Advertised device name"
    default "D133-Navi"

config BLE_NAVI_PREF_MTU
    int "Preferred ATT MTU"
    range 23 517
    default 247

config BLE_NAVI_CONN_INTERVAL_MS
    int "Requested connection interval (ms)"
    range 8 100
    default 15

config BLE_NAVI_CONN_CE_FULL
    bool "Request full-length connection events (max_ce_len 0xFFFF)"
    default y
    help
      Put in the connection parameter request. esp-idf's NimBLE
      throughput_app does the same (its comment: use the entire connection
      interval); NimBLE's own default is 0. Whether the AIC8800 controller
      honours it is unknown: switch off to compare.

config BLE_NAVI_LINK_TUNE_DELAY_MS
    int "Wait after connect before PHY / connection parameter requests (ms)"
    range 0 10000
    default 2000
    help
      Phones start their own link procedures right after connecting. Our
      2M PHY and connection parameter requests are sent after this delay
      and one after the other. 0 = immediately (the old behaviour, which
      dropped Android links with HCI 0x08 connection timeout).

config BLE_NAVI_MAX_FRAME_BYTES
    int "Largest accepted frame (bytes, CMA)"
    default 1228800
    help
      demo88 panel 1024x600 RGB565 = 1228800 (CMA, PSRAM). JPEG frames are
      typically 30-80 KB: prefer JPEG, raw full screens take 10+ s over BLE.

config BLE_NAVI_CHRONOS_COMPAT
    bool "Chronos app compatibility (NUS service, nav text + 48x48 icon)"
    default y

config BLE_NAVI_TURN_X
    int "Turn icon X"
    default 16
config BLE_NAVI_TURN_Y
    int "Turn icon Y"
    default 16
config BLE_NAVI_TURN_SCALE
    int "Turn icon scale (48px * N)"
    range 1 4
    default 2

config BLE_NAVI_DISP_LVGL
    bool "Show pictures through LVGL (lv_layer_top), not straight on the framebuffer"
    default y
    depends on LPKG_USING_LVGL && LVGL_V_9
    help
      Needed when the application runs LVGL: LVGL owns the framebuffer and
      uses the VE itself ("lv_mpp_dec_open: Invalid status" otherwise).
      Pictures are decoded in the LVGL thread and shown as an lv_image on the
      top layer. The application must call ble_navi_lv_attach() once from the
      LVGL thread; packages/artinchip/lvgl-ui/lv_demo.c does it in
      lv_user_gui_init().

config BLE_NAVI_ERYA
    bool "尔雅 BLE 导航协议 Ver 1.2 (领骑摩托 app: 0xAAA1..0xAAAA, EY/EB frames)"
    default y
    help
      GATT service with characteristics 0xAAA1..0xAAAA. The device name becomes
      <prefix><BT MAC>, AAA5 carries "<MAC>&<model key>", the app sends JPEG
      pictures on AAA7 and navigation JSON on AAA8.
      Needs cJSON: the helloworld application already builds one
      (application/rt-thread/helloworld/third/json). Do not also enable
      LPKG_USING_CJSON there, both would define the same symbols.

if BLE_NAVI_ERYA

config BLE_NAVI_ERYA_SVC_UUID
    hex "Primary service UUID (16-bit)"
    default 0xAAA0
    help
      The protocol document lists the characteristics 0xAAA1..0xAAAA only, not
      the service UUID. Change it if the app does not find the characteristics.

config BLE_NAVI_ERYA_NAME_PREFIX
    string "Device name prefix (name = prefix + MAC)"
    default "EY_"

config BLE_NAVI_ERYA_MODEL_KEY
    string "车型 key (issued by 尔雅 after the business agreement)"
    default ""

config BLE_NAVI_ERYA_PIC_W
    int "Requested picture width"
    default 480
    help
      Asked from the phone in AAA6. The decoded picture is kept in CMA
      (w x h x 2 bytes); on demo88 CMA is ~3.9 MB with ~2.4 MB taken by the
      framebuffers, so 800x480 (750 KB) starves the LVGL UI. 480x288
      (270 KB) is stretched to BLE_NAVI_ERYA_DISP_W x _H on screen.
config BLE_NAVI_ERYA_PIC_H
    int "Requested picture height"
    default 288
config BLE_NAVI_ERYA_PIC_Q
    int "Requested picture quality (120..200, ratio = value - 100)"
    range 120 200
    default 160
config BLE_NAVI_ERYA_PIC_TYPE
    string "Requested JPEG sampling (420 or 422)"
    default "420"

config BLE_NAVI_ERYA_DISP_X
    int "Picture X on screen"
    default 112
config BLE_NAVI_ERYA_DISP_Y
    int "Picture Y on screen"
    default 60
config BLE_NAVI_ERYA_DISP_W
    int "Picture width on screen (0 = as received)"
    default 800
config BLE_NAVI_ERYA_DISP_H
    int "Picture height on screen (0 = as received)"
    default 480

config BLE_NAVI_ERYA_LOG
    bool "Log every protocol step on the console (reads, writes, notifies, pictures)"
    default y

config BLE_NAVI_ERYA_MAX_PIC_BYTES
    int "Largest accepted picture (bytes)"
    default 524288

endif

endif
