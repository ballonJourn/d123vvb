# dataServer: C port of NikosMav/System-Programming-3 for RT-Thread
menuconfig LPKG_USING_DATASERVER
    bool "dataServer: multi-threaded file server (NikosMav/System-Programming-3 port)"
    depends on RT_USING_POSIX_SOCKET && RT_USING_POSIX_FS && RT_USING_PTHREADS
    default n
    help
      Clients request a directory below DATASERVER_ROOT and receive every
      file in it: path, size, then the data in DATASERVER_BLOCK_SIZE blocks.
      Compatible with the upstream remoteClient and rtthread/remote_client.py.

if LPKG_USING_DATASERVER
    config DATASERVER_PORT
        int "TCP port"
        default 9000

    config DATASERVER_POOL_SIZE
        int "Worker threads (-s)"
        range 1 4
        default 2

    config DATASERVER_QUEUE_SIZE
        int "File queue size (-q)"
        default 16

    config DATASERVER_BLOCK_SIZE
        int "Block size in bytes (-b)"
        range 512 16384
        default 4096

    config DATASERVER_ROOT
        string "Root directory clients may read (-r)"
        default "/data/adas"

    config DATASERVER_THREAD_STACK
        int "Stack size per thread"
        default 8192

    config DATASERVER_AUTOSTART
        bool "Start at boot"
        default y

    config DATASERVER_STAT_PORT
        int "Live stats port for the PC dashboard (0: off)"
        default 9001
        help
          One line of JSON per connection: per-interface byte/packet
          counters of e0/w0/w1 (netmon hooks on lwIP netif input and
          linkoutput) and the dataServer counters. Needs one RT-Thread
          thread (4 KB stack) and one socket. Frames the stack or the driver
          refuse are counted per interface (rx_drop, tx_err).

    config DATASERVER_LWIP_STATS
        bool "Report lwIP drop counters on the stats port (enables RT_LWIP_STATS)"
        depends on DATASERVER_STAT_PORT != 0
        select RT_LWIP_STATS
        default y
        help
          Adds the "lwip" object to the stats line: packets forwarded between
          e0 and w1, drops by layer, buffer pool and tcpip message pool errors,
          and the configured limits (PBUF_POOL_SIZE, MEMP_NUM_TCPIP_MSG_INPKT,
          TCPIP_MBOX_SIZE) those counters are to be read against. Tune the
          limits only after these counters show which one runs out.
endif
