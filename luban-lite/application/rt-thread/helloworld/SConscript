Import('RTT_ROOT')
Import('rtconfig')
from building import *

libs = ['']
lib_path = ['']

cwd  = GetCurrentDir()
path = [cwd, ]
path += [cwd + '/common']
path += [cwd + '/common/config']
path += [cwd + '/common/log']
path += [cwd + '/common/utils']
path += [cwd + '/hal/hal_pwm']
path += [cwd + '/hal/hal_eeprom']
path += [cwd + '/mw/init']
path += [cwd + '/mw/vehicle_param']
path += [cwd + '/mw/set_param']
path += [cwd + '/mw/uart_tpms']
path += [cwd + '/mw/can']
path += [cwd + '/mw/dashboard_state']
path += [cwd + '/mw/backlight']
path += [cwd + '/mw/key_module']
path += [cwd + '/mw/io_module']
path += [cwd + '/mw/mileage_param']
path += [cwd + '/mw/avg_consumption']
path += [cwd + '/mw/power_manage']
path += [cwd + '/mw/wireless_unlock']
path += [cwd + '/mw/pwm_cap']
path += [cwd + '/mw/dvr']
path += [cwd + '/mw/usbhost']
path += [cwd + '/third']
path += [cwd + '/third/json']
path += [cwd + '/third/carlink/inc']
path += [cwd + '/third/carlink/src']
lib_path += [cwd + '/third/carlink/lib']

src  = Glob('*.c')
src  += Glob('common/utils/*.c')
src  += Glob('hal/hal_pwm/*.c')
src  += Glob('hal/hal_eeprom/*.c')
src  += Glob('third/*.c')
src  += Glob('third/json/*.c')
src  += Glob('third/carlink/src/*.c')
src  += Glob('mw/init/*.c')
src  += Glob('mw/can/*.c')
src  += Glob('mw/dashboard_state/*.c')
src  += Glob('mw/vehicle_param/*.c')
src  += Glob('mw/set_param/*.c')
src  += Glob('mw/backlight/*.c')
src  += Glob('mw/key_module/*.c')
src  += Glob('mw/io_module/*.c')
src  += Glob('mw/mileage_param/*.c')
src  += Glob('mw/avg_consumption/*.c')
src  += Glob('mw/power_manage/*.c')
src  += Glob('mw/wireless_unlock/*.c')
src  += Glob('mw/pwm_cap/*.c')
src  += Glob('mw/dvr/*.c')
src  += Glob('mw/usbhost/*.c')
libs += ['libECTinyPlus_och.a']

CFLAGS = ' -c -ffunction-sections'

install = []
install =[('res/', 'data/')]

group   = DefineGroup('Applications', src, depend = [''], CPPPATH = path, CFLAGS=CFLAGS, INSTALL=install, LIBS = libs, LIBPATH = lib_path)
#group   = DefineGroup('Applications', src, depend = [''], CPPPATH = path, CFLAGS=CFLAGS, INSTALL=install)

list = os.listdir(cwd)
for item in list:
    if os.path.isfile(os.path.join(cwd, item, 'SConscript')):
        group = group + SConscript(os.path.join(item, 'SConscript'))

Return('group')
